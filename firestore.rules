/**
 * @fileoverview Firestore Security Rules for the Insemination Tracking App.
 *
 * @description
 * This ruleset is designed for the prototyping phase of an application that tracks
 * livestock insemination records. It provides a secure foundation by requiring
 * user authentication for all database interactions while allowing flexibility in
 * the data schema to support rapid development.
 *
 * Core Philosophy:
 * The security model assumes that all authenticated users are trusted operators
 * (e.g., veterinarians, administrative staff) with equal permissions to manage the
 * application's data. It enforces a strict "must be signed in" policy for all
 * read and write operations across the entire database. This prevents any
 * unauthorized or anonymous access.
 *
 * Data Structure:
 * The database is organized into several top-level collections:
 * - /inseminationRecords: The core collection for individual insemination events.
 * - /birthRecords: The collection for livestock birth reports.
 * - /puskeswans: Reference data for animal health centers.
 * - /breeders: Reference data for livestock breeders.
 * - /cows: Reference data for individual cows.
 * - /straws: Reference data for semen straws.
 * This flat structure simplifies data access and rule definition.
 *
 * Key Security Decisions:
 * - Authenticated Access Only: All collections require a user to be signed in
 *   for any type of access (read, list, create, update, delete). There is no
 *   publicly accessible data.
 * - No Ownership Model: The current data schema does not include user-specific
 *   ownership fields (e.g., `creatorId`, `ownerId`). Therefore, the rules do not
 *   restrict document modification to a specific owner. Any authenticated user
 *   can manage any document. This is suitable for a collaborative, internal tool
 *   but should be revisited with a more granular role or ownership system if the
 *   application's requirements change.
 * - Flexible Schema: In line with the prototyping philosophy, these rules do not
 *   validate the specific fields or data types of documents. The focus is solely
 *   on authorizing the user performing the request.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user making the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if a document exists before an update or delete operation.
     * This prevents operations on non-existent documents.
     */
    function isExistingDoc() {
      return resource != null;
    }

    // -------------------------------------------------------------------------
    // Collection: inseminationRecords
    // -------------------------------------------------------------------------

    match /inseminationRecords/{inseminationRecordId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingDoc();
      allow delete: if isSignedIn() && isExistingDoc();
    }

    // -------------------------------------------------------------------------
    // Collection: birthRecords
    // -------------------------------------------------------------------------

    match /birthRecords/{birthRecordId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingDoc();
      allow delete: if isSignedIn() && isExistingDoc();
    }

    // -------------------------------------------------------------------------
    // Collection: puskeswans
    // -------------------------------------------------------------------------

    match /puskeswans/{puskeswanId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingDoc();
      allow delete: if isSignedIn() && isExistingDoc();
    }

    // -------------------------------------------------------------------------
    // Collection: breeders
    // -------------------------------------------------------------------------

    match /breeders/{breederId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingDoc();
      allow delete: if isSignedIn() && isExistingDoc();
    }

    // -------------------------------------------------------------------------
    // Collection: cows
    // -------------------------------------------------------------------------

    match /cows/{cowId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingDoc();
      allow delete: if isSignedIn() && isExistingDoc();
    }

    // -------------------------------------------------------------------------
    // Collection: straws
    // -------------------------------------------------------------------------

    match /straws/{strawId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingDoc();
      allow delete: if isSignedIn() && isExistingDoc();
    }
  }
}